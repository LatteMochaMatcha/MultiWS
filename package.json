{
  "name": "oc-basemesh-workshop",
  "private": true,
  "version": "2.7.7",
  "description": "OC 白模工坊 v2 —— 多肢体角色白模生成器",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "serve": "vite",
    "build": "tsc --noEmit && vite build && node tools/run.mjs tools/update-manifest.ts",
    "preview": "vite preview",
    "pack": "npm run build && pwsh -NoProfile -File tools/pack.ps1",
    "apk": "npm run build && pwsh -NoProfile -File tools/apk.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "agent": "node tools/agent.mjs",
    "accept": "node tools/run.mjs tools/accept.ts",
    "release": "pwsh -NoProfile -File tools/release.ps1"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
